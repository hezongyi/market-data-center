[Unit]
Description=Market Data Center API
After=network.target

[Service]
EnvironmentFile=-/home/quant/repos/market-data-center/.env.local
WorkingDirectory=/home/quant/repos/market-data-center/backend
Environment=PYTHONPATH=/home/quant/repos/market-data-center/backend/src
Environment=DATACENTER_CANONICAL_ROOT=/home/quant/market_lake/canonical
Environment=DATACENTER_LEDGER_PATH=/home/quant/market_lake/canonical/audit/data_center.sqlite
Environment=DATACENTER_WEBUI_DIST=/home/quant/repos/market-data-center/webui/dist
ExecStart=/home/quant/repos/market-data-center/.venv/bin/python -m data_center.api
Restart=on-failure

[Install]
WantedBy=default.target
