[Unit]
Description=Market Data Center API
After=network.target

[Service]
EnvironmentFile=-%h/.config/market-data-center/env
WorkingDirectory=%h/market-data-center/releases/current
Environment=PYTHONPATH=%h/market-data-center/releases/current/backend/src
Environment=DATACENTER_CANONICAL_ROOT=/home/quant/market_lake/canonical
Environment=DATACENTER_LEDGER_PATH=/home/quant/market_lake/canonical/audit/data_center.sqlite
Environment=DATACENTER_DEPLOYMENT_MANIFEST=%h/market-data-center/releases/current/deployment.json
Environment=DATACENTER_WEBUI_DIST=%h/market-data-center/releases/current/webui/dist
ExecStart=%h/market-data-center/releases/current/.venv/bin/python -m data_center.api
Restart=on-failure

[Install]
WantedBy=default.target
