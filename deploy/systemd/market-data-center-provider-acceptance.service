[Unit]
Description=Market Data Center real provider acceptance
After=market-data-center-api.service market-data-center-worker.service

[Service]
Type=oneshot
WorkingDirectory=%h/market-data-center/releases/current
EnvironmentFile=%h/.config/market-data-center/env
Environment=PYTHONPATH=%h/market-data-center/releases/current/backend/src
Environment=DATACENTER_DEPLOYMENT_MANIFEST=%h/market-data-center/releases/current/deployment.json
ExecStart=%h/market-data-center/releases/current/.venv/bin/python -m data_center.acceptance
ExecStartPost=%h/market-data-center/releases/current/.venv/bin/python -m data_center.operations retention-audit
TimeoutStartSec=30min
