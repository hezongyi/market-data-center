# Portable development defaults; production paths belong in an ignored .env.local or service environment file.
DATACENTER_CANONICAL_ROOT=./var/canonical
DATACENTER_LEDGER_PATH=./var/canonical/audit/data_center.sqlite
DATACENTER_EVIDENCE_ROOT=./var/evidence
DATACENTER_BACKUP_ROOT=./var/backups
DATACENTER_API_KEY=
DATACENTER_WEBUI_DIST=./webui/dist
# Production sets these to the immutable release/current paths in systemd.
# DATACENTER_RELEASE_ROOT=/controlled/release/root
# DATACENTER_DEPLOYMENT_MANIFEST=/controlled/release/root/current/deployment.json
DATACENTER_RESTORE_STAGING_ROOT=./var/restore-staging
DATACENTER_WORKER_TIMEOUT_SECONDS=120
DATACENTER_MONITOR_RUNTIME_MAX_SECONDS=30
DATACENTER_MONITOR_DELIVERY_BATCH_SIZE=50
DATACENTER_MONITOR_DELIVERY_TIMEOUT_SECONDS=5
DATACENTER_MONITOR_DELIVERY_BUDGET_SECONDS=20
DATACENTER_CAPACITY_WARNING_FREE_RATIO=0.15
DATACENTER_CAPACITY_CRITICAL_FREE_RATIO=0.10
DATACENTER_PROXY_URL=
# Required only for FRED provider acceptance:
# FRED_API_KEY=
